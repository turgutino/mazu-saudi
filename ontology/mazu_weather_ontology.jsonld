    },
    "cfStandardName": "mazu:cfStandardName",
    "cfCellMethods": "mazu:cfCellMethods",
    "cfCoordinateConstraint": "mazu:cfCoordinateConstraint",
    "cfSupportingStandardName": "mazu:cfSupportingStandardName",
    "quantityKind": {
